	journaltitle = {Acoustical Physics},
	shortjournal = {Acoust. Phys.},
	author = {Korenbaum, V. I. and Nuzhdenko, A. V. and Tagiltsev, A. A. and Kostiv, A. E.},
	urldate = {2026-04-13},
